@page
@model Agri_Connect.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="ac-auth">
    <h1 class="ac-title">Create your farmer account</h1>
    <p class="ac-muted mb-4">List your produce and manage it in one place.</p>

    <form method="post" class="ac-card">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Input.Name" class="form-label"></label>
            <input asp-for="Input.Name" class="form-control" autocomplete="name" />
            <span asp-validation-for="Input.Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Location" class="form-label"></label>
            <input asp-for="Input.Location" class="form-control" placeholder="Town, Province" />
            <span asp-validation-for="Input.Location" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Register</button>
    </form>

    <p class="mt-3 text-center">Already registered? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
