@model ProductListViewModel
@{
    ViewData["Title"] = Model.Farmer?.Name ?? "Farmer";
}

<div class="ac-page-head">
    <div>
        <h1 class="ac-title">@Model.Farmer?.Name</h1>
        <p class="ac-muted mb-0">@Model.Farmer?.Email &middot; @Model.Farmer?.Location</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Back to farmers</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Farmer?.Id">Edit farmer</a>
    </div>
</div>

<partial name="_ProductFilter" model="Model" />
<partial name="_ProductTable" model="Model" />
